{
  "description": "An enforcing review with comments on failure only, on a pull request that adds a critically vulnerable runtime dependency: the action fails and creates the summary naming the advisory.",
  "inputs": {
    "comment-summary-in-pr": "on-failure",
    "warn-only": "false"
  },
  "routes": [
    {
      "method": "GET",
      "path": "/repos/offline/fixture/dependency-graph/compare/1111111111111111111111111111111111111111...2222222222222222222222222222222222222222",
      "status": 200,
      "body": [
        {
          "change_type": "added",
          "manifest": "package-lock.json",
          "ecosystem": "npm",
          "name": "offline-fixture-package",
          "version": "1.0.0",
          "package_url": "pkg:npm/offline-fixture-package@1.0.0",
          "license": "MIT",
          "source_repository_url": "https://github.com/offline/fixture-package",
          "scope": "runtime",
