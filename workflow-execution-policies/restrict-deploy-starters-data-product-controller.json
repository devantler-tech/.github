  "conditions": {
    "repository_name": {
      "include": [
        "data-product-controller"
      ],
      "exclude": []
    },
    "workflow_path": {
      "include": [
        ".github/workflows/release.yaml"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "restrict_actions_actors",
      "parameters": {
        "allowed_actors": [
          {
            "id": 26203420,
